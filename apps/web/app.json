{
  "expo": {
    "name": "FOKUS",
    "slug": "fokus",
    "scheme": "fokus",
    "version": "1.3.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": { "supportsTablet": true, "bundleIdentifier": "de.fokus.app" },
    "web": { "output": "static", "favicon": "./assets/favicon.png", "bundler": "metro" },
    "plugins": [["expo-router", { "sitemap": false }], "expo-font"]
  }
}
