# /opt/fokus/.env — wird von install.sh erzeugt. Nie ins Repo committen.

# Feste Version, nie "latest". Updates setzen diesen Wert (ab Phase 2 per Admin-Panel).
FK_VERSION=v0.1.0
FK_IMAGE_PREFIX=ghcr.io/javaplugin/fokus

# Öffentliche HTTPS-Adresse. Passkeys sind daran gebunden, später nicht mehr ändern.
PUBLIC_URL=https://fokus.example.de

# Zufällig erzeugt
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
BETTER_AUTH_SECRET=
SETUP_CODE=

# Cloudflare Zero Trust → Networks → Tunnels → Token
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARED_VERSION=2026.9.3

# Mailversand für Anmeldelinks und Einladungen
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="FOKUS <fokus@example.de>"
# Anzeigename des Absenders (Adresse aus SMTP_FROM). Die Adresse muss beim SMTP-Anbieter bestätigt sein.
MAIL_FROM_NAME=FOKUS

# Lese-Token für das private Repo (Releases + GHCR), Rechte: read:packages, contents:read
GHCR_USER=
GHCR_TOKEN=

TZ=Europe/Berlin
BACKUP_KEEP_DAYS=14
BACKUP_HOUR=3
